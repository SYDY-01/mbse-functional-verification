CTLSPEC NAME COV_REQ_FMCS_FLOW_16 := EF ((PL.state = off) & (PL.in_evPayloadActivate = TRUE));
CTLSPEC NAME COV_REQ_FMCS_FLOW_17 := EF (PL.state = on);
